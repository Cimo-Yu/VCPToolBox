# ChromeBridge 配置示例
# 复制此文件为 config.env 并根据需要修改

# 是否启用调试模式（打印详细日志）
# 默认值: false
DebugMode=false

# ===== 抖音字幕 ASR（douyin_captions 视频无自带字幕时自动转写）=====
# 流程：下载无水印视频 -> ffmpeg 抽音频 -> 调 OpenAI 兼容转写接口
# 默认关闭；开启前请确认 ffmpeg 可用（VCPToolBox/bin/ffmpeg/bin/ffmpeg.exe 已内置）
DOUYIN_ASR_ENABLED=false
DOUYIN_ASR_BASE_URL=https://api.openai.com/v1
DOUYIN_ASR_API_KEY=
DOUYIN_ASR_MODEL=whisper-1
DOUYIN_ASR_TIMEOUT_MS=300000

# Browser Runtime V3 渐进增强。总开关关闭时保持旧协议兼容。
VCP_CHROME_PROTOCOL_V3=false
# 稳定快照 Hash 默认开启，用于消除 Snapshot/Generated-At 造成的重复上报。
VCP_CHROME_STABLE_SNAPSHOT_HASH=true
VCP_CHROME_INTERACTION_TREE=false
VCP_CHROME_CDP_ENHANCED_SNAPSHOT=false
VCP_CHROME_CDP_INPUT=false
VCP_CHROME_ACTION_VERIFICATION=false
VCP_CHROME_SNAPSHOT_DIFF=false
VCP_CHROME_STRICT_DOCUMENT_GENERATION=false
# 服务端脱敏策略默认开启；浏览器扩展 Popup 另有用户可见的本地开关，亦默认开启。
VCP_CHROME_REDACT_SENSITIVE_DOM=true
VCP_CHROME_ACTION_BACKEND=auto
VCP_CHROME_SNAPSHOT_BACKEND=auto
VCP_CHROME_METRICS_ENABLED=true
