# ChromeBridge 配置示例
# 复制此文件为 config.env 并根据需要修改

# 是否启用调试模式（打印详细日志）
# 默认值: false
DebugMode=false

# ===== 抖音字幕 ASR（douyin_captions 视频无自带字幕时自动转写）=====
# 流程：下载无水印视频 -> ffmpeg 抽音频 -> 调 OpenAI 兼容转写接口
# 默认关闭；开启前请确认 ffmpeg 可用（VCPToolBox/bin/ffmpeg/bin/ffmpeg.exe 已内置）
DOUYIN_ASR_ENABLED=false
DOUYIN_ASR_BASE_URL=https://api.openai.com/v1
DOUYIN_ASR_API_KEY=
DOUYIN_ASR_MODEL=whisper-1
DOUYIN_ASR_TIMEOUT_MS=300000
